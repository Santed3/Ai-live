{
  "name": "screenbubble-desktop",
  "version": "1.0.0",
  "description": "ScreenBubble: AI-assistent med sidopanel för Windows",
  "main": "main.js",
  "author": "ScreenBubble",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.example.screenbubble.desktop",
    "productName": "ScreenBubble",
    "files": ["main.js", "preload.js", "renderer/**", "config.json", "package.json"],
    "publish": [{ "provider": "github", "owner": "Santed3", "repo": "Ai-live", "releaseType": "release" }],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "ScreenBubble-Setup.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
